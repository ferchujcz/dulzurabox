rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública para el catálogo interactivo de DulzuraBox
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true; // Para mayor restricción en producción, usar request.auth != null
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Para mayor restricción en producción, usar request.auth != null
    }
  }
}
